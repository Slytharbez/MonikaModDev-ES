# game/zz_cardgames.rpy:4351
translate spanish monika_explain_nou_rules_4cd45a56:

    # m 3eua "Usually, you can only play them if you have no other cards of the same color as the discard pile, but we're playing with our own rules."
    m 3eua "Normalmente, solo podrías jugarlas si no tienes otras cartas del mismo color que la pila de descarte, pero estamos jugando con nuestras propias reglas."

# game/zz_cardgames.rpy:4353
translate spanish monika_explain_nou_rules_23d4d830:

    # m 1eua "When you play any {i}Wild{/i} card, you should choose what color you want to set for it."
    m 1eua "Cuando juegues cualquier carta {i}Comodín{/i}, debes elegir el color que quieras establecer para ella."

# game/zz_cardgames.rpy:4354
translate spanish monika_explain_nou_rules_7fc7ecd0:

    # m "As powerful as {i}Wild{/i} and {i}Action{/i} cards may look, you can still save yourself from them."
    m "Aunque las cartas de {i}Comodín{/i} y {i}Acción{/i} parezcan muy poderosas, igual puedes salvarte de ellas."

# game/zz_cardgames.rpy:4355
translate spanish monika_explain_nou_rules_8d2439c3:

    # m 1eub "For example you can mirror a {i}Wild Draw Four{/i} by playing a {i}Draw Two{/i} with the new color."
