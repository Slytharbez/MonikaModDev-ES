    m 1eua "Si un[o_a] de nosotr[o_a]s olvida decir 'NOU', el otro puede {i}recordárselo{/i}. Eso hará que la persona desafortunada robe 2 cartas más."

# game/zz_cardgames.rpy:4341
translate spanish monika_explain_nou_rules_723caba0:

    # m 3eub "Besides the {i}Number{/i} cards, there are also special cards known as {i}Action{/i} and {i}Wild{/i} cards."
    m 3eub "Además de las cartas {i}Numéricas{/i}, también hay cartas especiales llamadas cartas de {i}Acción{/i} y {i}Comodín{/i}."

# game/zz_cardgames.rpy:4342
translate spanish monika_explain_nou_rules_236de0e1:

    # m 3eua "You can distinguish an {i}Action{/i} card by its symbol, and a {i}Wild{/i} card by its black color."
    m 3eua "Puedes distinguir una carta de {i}Acción{/i} por su símbolo y una carta de {i}Comodín{/i} por su color negro."

# game/zz_cardgames.rpy:4343
translate spanish monika_explain_nou_rules_eec6cbf9:

    # m 1eua "These cards can make your opponent skip their turn or even draw more cards."
    m 1eua "Estas cartas pueden hacer que tu oponente se salte su turno o incluso robe más cartas."

# game/zz_cardgames.rpy:4344
translate spanish monika_explain_nou_rules_ad6f05b8:

    # m 1tsu "And by more, I mean 12 cards in a row."
    m 1tsu "Y por más, me refiero a 12 cartas seguidas."

# game/zz_cardgames.rpy:4345
translate spanish monika_explain_nou_rules_f4e809fc:

    # m 1eua "{i}Wild{/i} cards don't have a color which means they can be placed on any card."
    m 1eua "Las cartas {i}Comodín{/i} no tienen color, lo que significa que se pueden colocar sobre cualquier carta."

# game/zz_cardgames.rpy:4348
translate spanish monika_explain_nou_rules_892f5a36:

    # m 3eua "If you have no other cards with the color of the discard pile, that is."
