    # m 1hfw "Come on, let me out already!"
    m 1hfw "¡Vamos, déjame salir ya!"

# game/script-anniversary.rpy:786
translate spanish anni_50_6111571a:

    # m 1dsc "..."
    m 1dsc "..."

